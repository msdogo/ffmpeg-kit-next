#!/usr/bin/env bash
# =============================================================================
#  FFmpegKitNext 改名（rebrand）唯一配置文件
#
#  所有值都可以被同名环境变量覆盖：GitHub Actions 里 env: 块中设置的值优先，
#  本文件的默认值只作为兜底。所以日常改名只需要改 Actions 的 env 块，
#  本地跑脚本时也可以 `export XXX=...` 临时覆盖。
# =============================================================================

# ---------------------------------------------------------------------------
# 1. 原生动态库前缀（关键：解决和 DJI SDK 的 libavcodec.so 重名冲突）
# ---------------------------------------------------------------------------
# 改名后的产物：
#   libavcodec.so    -> lib<前缀>_avcodec.so
#   libavdevice.so   -> lib<前缀>_avdevice.so
#   libavfilter.so   -> lib<前缀>_avfilter.so
#   libavformat.so   -> lib<前缀>_avformat.so
#   libavutil.so     -> lib<前缀>_avutil.so
#   libswresample.so -> lib<前缀>_swresample.so
#   libswscale.so    -> lib<前缀>_swscale.so
#   libffmpegkit.so  -> lib<前缀>.so
#   libffmpegkit_abidetect.so -> lib<前缀>_abidetect.so
#
# 只允许 小写字母 / 数字 / 下划线，且以字母开头。
export REBRAND_NATIVE_PREFIX="${REBRAND_NATIVE_PREFIX:-fkit}"

# ---------------------------------------------------------------------------
# 2. Java / Kotlin 包名（连同 JNI 符号一起改）
# ---------------------------------------------------------------------------
# 旧包名，不要改
export REBRAND_OLD_JAVA_PACKAGE="${REBRAND_OLD_JAVA_PACKAGE:-com.arthenica.ffmpegkit}"
# 新包名，换成你自己的反向域名
export REBRAND_JAVA_PACKAGE="${REBRAND_JAVA_PACKAGE:-com.fkit.ffmpegkit}"

# ---------------------------------------------------------------------------
# 3. Maven 坐标与产物文件名
# ---------------------------------------------------------------------------
# 本地 Maven 仓库里的 groupId
export REBRAND_GROUP_ID="${REBRAND_GROUP_ID:-com.fkit}"
# artifactId（同时也是 pom / aar 的文件名前缀）
export REBRAND_ARTIFACT_ID="${REBRAND_ARTIFACT_ID:-ffmpeg-kit}"
# gradle 的 base.archivesName，决定 .aar 文件名 <值>-release.aar
export REBRAND_ARCHIVE_NAME="${REBRAND_ARCHIVE_NAME:-ffmpeg-kit}"

# ---------------------------------------------------------------------------
# 4. 可选项
# ---------------------------------------------------------------------------
# 1 = 从 AAR 中删掉 libc++_shared.so（你工程里已经有同一个 libc++_shared.so 时用）
export REBRAND_STRIP_LIBCXX_SHARED="${REBRAND_STRIP_LIBCXX_SHARED:-0}"

# Android API level（同时决定 prebuilt/bundle-android-aar-<API>-maven 目录名）
export REBRAND_API_LEVEL="${REBRAND_API_LEVEL:-24}"

# 仓库根目录，留空表示自动推导（脚本所在目录往上两级）
export REBRAND_REPO_ROOT="${REBRAND_REPO_ROOT:-}"

export REBRAND_FFMPEG_LIBS="avcodec avdevice avfilter avformat avutil swresample swscale"
